{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Apply premium blog images",
			"type": "shell",
			"command": "py",
			"args": [
				"-3",
				"scripts/apply_site_audit_fixes.py"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Finalize premium blog metadata",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"py -3 scripts\\apply_site_audit_fixes.py && py -3 scripts\\add_image_dimensions.py && py -3 scripts\\generate_hreflang.py && py -3 scripts\\generate_sitemap.py"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Validate blog redirect images",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"py -3 scripts\\apply_site_audit_fixes.py && py -3 -u scripts\\audit_website.py"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		}
	]
}